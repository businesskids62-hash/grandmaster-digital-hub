# ==========================================
# GRANDMASTER DIGITAL HUB — ENVIRONMENT CONFIGURATION
# Step 3: Deployment — Vercel Serverless
# ==========================================
#
# LOCAL DEVELOPMENT:
#   Copy this file to .env (never commit .env)
#   Set your actual values in .env
#   Run: npm run server  (backend)
#   Run: npm run dev     (frontend)
#
# VERCEL DEPLOYMENT:
#   Do NOT upload .env to Vercel.
#   Instead, set each variable in the Vercel Dashboard:
#     Project → Settings → Environment Variables
#   Variable names must match exactly (case-sensitive).
#
# ==========================================

# Active AI provider (options: gemini)
AI_PROVIDER=gemini

# Model name for Google Gemini
# Options: gemini-3.8-flash, gemini-flash-latest, gemini-3.5-flash
AI_MODEL=gemini-3.8-flash

# Google Gemini API Key
# Obtain a free key from: https://aistudio.google.com/
# NEVER commit your actual API key to version control.
# On Vercel: set this in Dashboard → Settings → Environment Variables
GEMINI_API_KEY=

# Backend server port (local development only — Vercel ignores this)
PORT=5000

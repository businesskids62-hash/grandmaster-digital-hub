# ==========================================
# GRANDMASTER DIGITAL HUB — ENVIRONMENT CONFIGURATION
# Step 3: Deployment — Vercel Serverless / Express
# ==========================================
#
# LOCAL DEVELOPMENT:
#   Copy this file to server/.env (never commit .env)
#   Set your actual values in server/.env
#   Run: npm run server  (backend)
#   Run: npm run dev     (frontend)
#
# VERCEL DEPLOYMENT:
#   Do NOT upload .env to Vercel.
#   Set each variable in the Vercel Dashboard:
#     Project → Settings → Environment Variables
#
# ==========================================

# Provider chain (comma-separated list of provider:model)
AI_PROVIDERS=gemini:gemini-3.5-flash-lite,gemini:gemini-flash-lite-latest

# Primary model (takes precedence over AI_PROVIDERS / GEMINI_MODEL).
# Verify the ID with the provider list-models endpoint before changing it.
AI_MODEL=gemini-3.5-flash-lite

# Optional fallback model used when the primary fails or is rate limited.
AI_FALLBACK_MODEL=gemini-flash-lite-latest

# Legacy model names (only used when AI_MODEL / AI_PROVIDERS are unset)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Per-client chat requests per minute (default 10) and short-lived success
# response cache in milliseconds (default 60000, set 0 to disable caching).
AI_RATE_LIMIT_PER_MINUTE=10
AI_RESPONSE_CACHE_TTL_MS=60000

# Maximum simultaneous upstream AI calls per process (default 4, max 16).
AI_MAX_CONCURRENCY=4

# Google Gemini API Key (Server-side secret only - never expose to client)
GEMINI_API_KEY=

# Allowed CORS Origins (comma-separated, exact match, no wildcards).
# Production must set this explicitly; if unset in production the allow-list is
# empty (fail closed). In development the Vite origins 5174/5173 (localhost and
# 127.0.0.1) are allowed by default. ALLOWED_ORIGINS remains a legacy alias.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,https://grandmaster-digital-hub.vercel.app

# ==========================================
# PHASE 3 (server-side only — never expose to the browser)
# ==========================================
# UI SESSION AUTHENTICATION (server-side only — never expose to the browser)
# Every private /api route requires a signed HttpOnly session cookie.
# GRANDMASTER_UI_PASSWORD: the password asked by the sign-in screen (min 12 chars).
# GRANDMASTER_SESSION_SECRET: HMAC key for the session cookie (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If either is unset or too short, private routes answer 503 AUTH_NOT_CONFIGURED
# and the public /api/health liveness route keeps working.
GRANDMASTER_UI_PASSWORD=
GRANDMASTER_SESSION_SECRET=

# Failed sign-in attempts allowed per client per minute (default 5).
AUTH_RATE_LIMIT_PER_MINUTE=5

# Authorizes task approvals, memory mutations and audit access. Minimum 16 characters;
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server-side only: never send this token to the browser or a model.
# Private routes still require a signed-in session; the server injects this token
# internally only after the session check, so the constant-time comparison runs
# without the browser ever holding it.
# If unset, approvals are refused with APPROVAL_AUTHORITY_NOT_CONFIGURED.
GRANDMASTER_CONTROL_TOKEN=

# Data directory for tasks, memory and audit (default: ./data locally, /tmp on Vercel).
# LOCAL: JSON files survive restarts only while this directory persists.
# VERCEL: /tmp is per-instance and ephemeral; cold starts and other instances do not share it.
# Browser "Memory" is localStorage and is separate from this server-side JSON memory.
# Server memory is single-tenant: reads, searches and mutations all require the shared control token,
# but there is no per-user isolation or per-user identity.
# The shared control token is application-level authorization, not user authentication.
# Reliable production durability requires a separately approved external store; none is configured here.
GRANDMASTER_DATA_DIR=

# ==========================================
# MT5 READ-ONLY BRIDGE (optional)
# ==========================================
# Loopback URL of a read-only bridge that serves GET {url}/snapshot as JSON.
# Only http(s)://localhost, 127.0.0.0/8 or [::1] are accepted. Credentials in
# the URL, query strings, fragments and non-loopback hosts are blocked.
# The app never logs in to MT5, never stores broker credentials and never
# sends orders, closes positions or withdraws funds.
# The bundled local bridge (mt5_bridge/bridge.py) serves the same contract on
# http://127.0.0.1:8765 and is started by `npm run dev` as dev:mt5.
# Example: http://127.0.0.1:8765
# On Vercel, a bridge running on your own machine is not reachable.
MT5_BRIDGE_URL=http://127.0.0.1:8765

# Optional read-only symbol health surfaced by the bundled bridge.
# No symbol is selected and no terminal setting is changed.
MT5_SYMBOL=XAUUSDm
MT5_STALE_SECONDS=120

# ==========================================
# LOCAL BROWSER OPERATOR (Phase G1a — local only)
# ==========================================
# Separate from GRANDMASTER_CONTROL_TOKEN. The operator token can create
# sessions/plans; the control token is additionally required to approve a plan.
# A model must never hold either secret. Leave empty to disable the operator
# entirely (all operator endpoints then fail closed with 503).
# Format: JSON object of ownerId -> token. Each token must be 16+ characters.
# GRANDMASTER_OPERATOR_USERS={"owner-a":"replace-with-a-long-random-token"}
GRANDMASTER_OPERATOR_USERS=

# HTTPS hosts the operator may navigate. Comma-separated exact hosts or
# wildcard subdomains (*.example.com). IP literals are rejected unless loopback.
# Empty means no navigation is allowed.
GRANDMASTER_OPERATOR_ALLOWED_HOSTS=

# Loopback (localhost / 127.0.0.1 / [::1]) is blocked unless this is 1 AND the
# host is also listed above. Intended only for explicit local testing.
GRANDMASTER_OPERATOR_ALLOW_LOOPBACK=

# Local browser channel: msedge (default) or chrome. Uses the installed browser;
# no browser is downloaded. playwright-core is a local dependency only.
GRANDMASTER_OPERATOR_BROWSER_CHANNEL=msedge

# Per-operation browser timeout in milliseconds (clamped to 1000–30000).
GRANDMASTER_OPERATOR_TIMEOUT_MS=15000

# Opt-in real connector verification (launches the installed browser against a
# loopback fixture; no real website is visited):
#   GRANDMASTER_OPERATOR_REAL_TEST=1 npm run test:operator:real
# On success it writes data/operator-verification.json (browser, version and
# timestamp only). The UI stays NOT CONNECTED until that evidence exists and
# GRANDMASTER_OPERATOR_USERS plus GRANDMASTER_OPERATOR_ALLOWED_HOSTS are set.

# Per-owner limits. Sessions are ephemeral and never persist cookies or profiles.
GRANDMASTER_OPERATOR_MAX_SESSIONS=3
GRANDMASTER_OPERATOR_IDLE_TTL_MINUTES=30
GRANDMASTER_OPERATOR_APPROVAL_TTL_MINUTES=10
GRANDMASTER_OPERATOR_MAX_RUNS=50

# On Vercel/serverless the operator returns 503 OPERATOR_SERVERLESS_UNSUPPORTED.
# No browser session, desktop control, CAPTCHA solving or file transfer is provided.

# Write requests per minute per client for /api/v1 (default: 30).
GRANDMASTER_RATE_LIMIT_PER_MINUTE=30

# Set to 1 to suppress structured server logs (used by automated tests).
GRANDMASTER_LOG_SILENT=

# Optional Frontend API URL override (leave empty for same-origin /api proxying)
VITE_API_URL=

# Backend server port (local development only)
PORT=5000

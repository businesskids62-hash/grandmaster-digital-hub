{
  "name": "grandmaster-digital-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,mt5,web -c blue,yellow,magenta \"npm:dev:api\" \"npm:dev:mt5\" \"npm:dev:web\"",
    "dev:api": "cross-env PORT=8000 HOST=127.0.0.1 node server/server.js",
    "dev:mt5": "python mt5_bridge/bridge.py",
    "dev:web": "wait-on -t 60000 --status-codes 200-599 http-get://127.0.0.1:8000/api/health && vite",
    "check": "node scripts/check-health.mjs",
    "server": "cross-env PORT=8000 HOST=127.0.0.1 node server/server.js",
    "server:gen5": "node server.cjs",
    "test": "node scripts/test-suite.js && node --test --test-concurrency=1 tests/aiProviders.test.js tests/core.test.js tests/api.test.js tests/agentOperations.test.js tests/security.test.js tests/memory.test.js tests/health.test.js tests/reliability.test.js tests/mt5.test.js tests/operator.test.js tests/operatorUi.test.js tests/diagnostics.test.js tests/seo.test.js tests/academy.test.js tests/authLockout.test.js tests/dbAsync.test.js tests/pwa.test.js tests/dataContracts.test.js",
    "test:operator": "node --test tests/operator.test.js",
    "test:operator:real": "node --test tests/operatorReal.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:load": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.64.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.3",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}

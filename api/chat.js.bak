export default async function handler(req, res) {
  // CORS
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Methods", "POST, OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");

  if (req.method === "OPTIONS") {
    return res.status(200).end();
  }

  if (req.method !== "POST") {
    return res.status(405).json({ error: "Method not allowed" });
  }

  try {
    const { message } = req.body;

    if (!message) {
      return res.status(400).json({ reply: "Message khali hai General!" });
    }

    // Gemini API call
    const apiKey = process.env.GEMINI_API_KEY;
    const model = process.env.AI_MODEL || "gemini-3.8-flash";

    if (!apiKey) {
      return res
        .status(503)
        .json({ reply: "AI not configured: GEMINI_API_KEY is missing." });
    }

    const controller = new AbortController();
    const timeoutMs = Number(process.env.AI_TIMEOUT_MS) || 30000;
    const timer = setTimeout(() => controller.abort(), timeoutMs);

    try {
      const response = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent?key=${encodeURIComponent(apiKey)}`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            contents: [{ parts: [{ text: message }] }],
          }),
          signal: controller.signal,
        },
      );

      clearTimeout(timer);

      if (!response.ok) {
        const detail = await response.text().catch(() => "");
        console.error(`[ai] Gemini ${model} HTTP ${response.status}: ${detail}`);
        if (response.status === 404) {
          return res.status(502).json({
            reply: `AI model "${model}" not found. Check AI_MODEL in Vercel env vars.`,
          });
        }
        return res
          .status(502)
          .json({ reply: `AI provider error (HTTP ${response.status}).` });
      }

      const data = await response.json();
      const reply =
        data.candidates?.[0]?.content?.parts?.[0]?.text || "No reply from Gemini";

      return res.status(200).json({ reply });
    } catch (fetchError) {
      clearTimeout(timer);
      if (fetchError.name === "AbortError") {
        console.error(`[ai] Gemini ${model} request timed out after ${timeoutMs / 1000}s`);
        return res
          .status(504)
          .json({ reply: `AI request timed out after ${timeoutMs / 1000}s.` });
      }
      console.error(`[ai] Gemini ${model} fetch error:`, fetchError);
      return res.status(502).json({ reply: "Could not reach the AI provider." });
    }
  } catch (error) {
    console.error(error);
    return res.status(500).json({ reply: "Backend error: " + error.message });
  }
}
